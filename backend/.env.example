# Zoho Analytics OAuth 2.0 — see https://www.zoho.com/analytics/api/v2/
# Create a "Self Client" (or server-based client) at https://api-console.zoho.com
# to obtain these values, then generate a refresh token via the OAuth grant flow.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=

# Zoho account/API domains — use .in for India-hosted accounts (default),
# .com for US, .eu for Europe, etc. Must match where the Scimplify SMPLOK
# workspace is hosted.
ZOHO_ACCOUNT_DOMAIN=https://accounts.zoho.in
ZOHO_ANALYTICS_DOMAIN=https://analyticsapi.zoho.in

# Zoho Analytics organization and workspace identifiers
ZOHO_ORG_ID=
ZOHO_WORKSPACE_ID=
ZOHO_WORKSPACE_NAME=SMPLOK

# Calculation parameters
EARLY_PAY_RATE=0.35

# CORS — comma-separated list is not supported by pydantic-settings list
# parsing from env vars directly; override via a JSON array string if needed,
# e.g. CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173"]
